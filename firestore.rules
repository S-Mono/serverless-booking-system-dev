rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 👑 管理者判定 (カスタムクレームをチェック)
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // 👤 本人判定
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    // 🔑 ログイン済み判定
    function isAuthenticated() {
      return request.auth != null;
    }

    // 📞 ログイン中ユーザー自身の電話番号に一致する顧客ドキュメントか
    // (電話番号ログインは「電話番号@local.booking-system」のメールで認証される)
    // クエリ where('phone_number','==',自分の番号) のみ許可される
    function isOwnPhoneRecord() {
      return request.auth != null
        && 'email' in request.auth.token
        && request.auth.token.email.matches('.*@local[.]booking-system')
        && resource.data.phone_number == request.auth.token.email.split('@')[0];
    }

    // 🙋 customer_id が自分の顧客IDか
    // (UID一致、または管理者が事前登録した顧客ドキュメントの電話番号が自分と一致)
    function ownsCustomer(customerId) {
      return isOwner(customerId)
        || (request.auth != null
            && 'email' in request.auth.token
            && request.auth.token.email.matches('.*@local[.]booking-system')
            && get(/databases/$(database)/documents/customers/$(customerId)).data.phone_number
               == request.auth.token.email.split('@')[0]);
    }

    // 🚫 一般ユーザーが書き込んではいけない特権フィールド
    function hasPrivilegedFields(data) {
      return data.keys().hasAny(['role', 'admin', 'is_admin', 'isAdmin']);
    }

    // 📅 予約データ (reservations)
    // 空き枠の確認は Cloud Function(getBusySlots) 経由。他人の予約は読めない。
    match /reservations/{reservationId} {
      allow read, write: if isAdmin();
      allow read: if ownsCustomer(resource.data.customer_id);
      // 新規作成は本人名義の「仮予約(pending)」のみ
      allow create: if ownsCustomer(request.resource.data.customer_id)
        && request.resource.data.status == 'pending';
      // 顧客によるキャンセル(削除)は本人のみ。更新(ステータス/金額変更)は不可
      allow delete: if ownsCustomer(resource.data.customer_id);
    }

    // 📩 メッセージデータ (messages)
    match /messages/{messageId} {
      allow read, write: if isAdmin();
      allow read: if ownsCustomer(resource.data.customer_id);
      allow create: if ownsCustomer(request.resource.data.customer_id);
      allow update, delete: if ownsCustomer(resource.data.customer_id);
    }

    // 📧 お問い合わせデータ (contacts)
    match /contacts/{contactId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }

    // 👥 顧客データ (customers)
    match /customers/{userId} {
      allow read, write: if isAdmin();
      // 本人 または 自分の電話番号に一致する顧客のみ参照可（名寄せ用）
      allow get: if isOwner(userId) || isOwnPhoneRecord();
      allow list: if isOwnPhoneRecord();
      // 新規登録・更新は本人のみ。role 等の特権フィールドは書き込み不可
      allow create: if isOwner(userId) && !hasPrivilegedFields(request.resource.data);
      allow update: if isOwner(userId)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['role', 'admin', 'is_admin', 'isAdmin']);
    }

    // 📋 マスタデータ
    match /menus/{menuId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // 🏷️ メニュータグ (menu_tags)
    match /menu_tags/{tagId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // 📂 メニューカテゴリ (menu_categories)
    match /menu_categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /staffs/{staffId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /shop_config/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 🔔 通知トークン (admin_tokens)
    match /admin_tokens/{tokenId} {
      allow read, write: if isAdmin();
    }

    // 🏥 顧客カルテ (customer_medical_records) - 管理者のみ
    match /customer_medical_records/{document=**} {
      allow read, create, update, delete: if isAdmin();
    }

    // 🔑 パスワードリセットリクエスト
    // クライアントからは一切アクセス不可（Cloud Functions の Admin SDK のみ）
    match /password_reset_requests/{requestId} {
      allow read, write: if false;
    }

    // 🐛 エラーログ (error_logs) - 審査時のエラー収集用
    // 認証済みユーザーのみ、許可フィールド・サイズ制限付きで作成可能
    match /error_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly([
          'message', 'name', 'stack', 'context', 'userAgent', 'url',
          'timestamp', 'stage', 'liffId', 'isInClient', 'isLoggedIn'
        ])
        && (!('message' in request.resource.data) || request.resource.data.message == null
            || request.resource.data.message.size() <= 2000)
        && (!('stack' in request.resource.data) || request.resource.data.stack == null
            || request.resource.data.stack.size() <= 5000);
    }
    // 🔍 【一時】LINE User ID ログ（確認後削除）
    match /tmp_line_uid_log/{docId} {
      allow read: if isAdmin();
      allow create, update: if isAuthenticated();
    }

    match /incoming_calls/{callId} {
      // 管理者のみリアルタイム読み取り可能
      allow read: if request.auth != null && request.auth.token.admin == true;
      // クライアント側からの直接書き込みは拒否（Python側Admin SDKのみ許可）
      allow write: if false;
    }  
  }
}